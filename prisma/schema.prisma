// Admin module schema — starting point for a new project.
// Keep AdminUser exactly as-is. Add your own content models below it
// (this project's version has NewsPost / Vacancy / Application — replace
// with whatever this new project manages).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// Add your content models here, e.g.:
//
model NewsPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  imageUrl    String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vacancy {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  location     String?
  description  String
  isOpen       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  vacancyId String
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String
  cvUrl     String
  createdAt DateTime @default(now())

  @@index([vacancyId])
}
